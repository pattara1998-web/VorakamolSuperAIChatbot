// Schema definition for the database
datasource db {
  provider = "mongodb" // Assuming MongoDB based on common practices, adjust if needed
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- New Model: FacebookPage ---
model FacebookPage {
  id             String    @id @default(uuid())
  name           String
  accessToken    String    @unique // Store the long-lived access token
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relation to Product (One-to-Many)
  products       Product[]
}

// --- Updated Model: Product ---
model Product {
  id             String    @id @default(uuid())
  name           String
  description    String?
  price          Float
  // Foreign Key and Relation to FacebookPage
  pageId         String
  page            FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

