# Environment Variables
# Copy to .env for local development. On Render, set these in the Dashboard
# (or via render.yaml) — never commit real secrets.

# Server Configuration
# Render injects PORT automatically; local dev falls back to 3000.
PORT=3000

# Persistence
# Path of the JSON snapshot written by the in-memory store.
# On Render free tier the disk is ephemeral; for durable storage attach a
# Render Disk mounted at /var/data and set DATA_FILE=/var/data/superai-v2.8.json
DATA_FILE=data/superai-v2.8.json

# Database Connection (PostgreSQL — the only database the system uses)
# Production: point at any hosted Postgres (Render / Neon / Supabase).
# Local dev: leave UNSET and the server runs the same SQL on PGlite
# (real PostgreSQL as WASM, persisted under data/pglite) automatically.
# DATABASE_URL="postgresql://user:password@host:5432/superai"

# AI Service Configuration
# (แนะนำ: ใส่คีย์ผ่านหน้าเว็บ "ตั้งค่า AI" แทนไฟล์นี้ — ระบบเลือกโมเดลที่ดีที่สุดให้อัตโนมัติ)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── ระบบล็อกอิน (Trusted Device + PIN Gate) ──
# เครื่องที่เคยล็อกอินสำเร็จจะใช้ PIN สั้นได้ (PIN เริ่มต้น = รหัสความปลอดภัยเดิม)
# ผู้ใช้งานจริง (hash = sha256(ค่า + 'superai_salt_2026')) — ถ้าไม่ตั้ง ใช้ค่าเริ่มต้นของระบบ
# ADMIN_USERNAME="adminpremium"
# ADMIN_PASSWORD_HASH=""
# ADMIN_SECURITY_CODE_HASH=""
# ADMIN_PIN_HASH=""

# Facebook Graph API Configuration
FACEBOOK_APP_ID="YOUR_FACEBOOK_APP_ID"
FACEBOOK_APP_SECRET="YOUR_FACEBOOK_APP_SECRET"
FACEBOOK_VERIFY_TOKEN="YOUR_FACEBOOK_VERIFY_TOKEN"
META_GRAPH_API_VERSION="v24.0"
# OAuth scopes for Facebook connect (comma-separated).
# IMPORTANT: `pages_manage_posts` and `pages_manage_engagement` are ADVANCED
# permissions that Meta rejects with "Invalid Scopes" until the app passes
# App Review (Advanced Access). The default below uses only Standard Access
# scopes that work immediately for new apps.
# Once Meta approves Advanced Access, add `pages_manage_engagement` here
# (needed for comment replies).
FB_OAUTH_SCOPES="pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging"

# Security
# Secret used to AES-256-GCM encrypt stored tokens/API keys.
# Render generates one automatically via render.yaml (generateValue: true).
ENCRYPTION_SECRET_KEY="YOUR_32_CHAR_RANDOM_SECRET"
